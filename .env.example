# Copy this file to .env and fill in the values. Never commit .env.

# Supabase → Connect → Session pooler connection string (with your DB password filled in)
DATABASE_URL=

# Google AI Studio → Get API key
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Timezone used when a user hasn't set one
DEFAULT_TIMEZONE=Asia/Kolkata

# ── WhatsApp Cloud API (Meta → your app → WhatsApp → API Setup) ──
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Meta app → App settings → Basic → App secret (used to verify webhook signatures)
WHATSAPP_APP_SECRET=
# Any random string; paste the same value into Meta's webhook "Verify token" field
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v22.0

# Protects /cron/run-reminders (called by Supabase pg_cron in production)
CRON_SECRET=

# Needed only to create the onboarding form (scripts/create_onboarding_flow.py)
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ONBOARDING_FLOW_ID=
WHATSAPP_FLOW_MODE=draft

# Web simulator on/off (turn off on a public server)
SIMULATOR_ENABLED=true
SCHEDULER_ENABLED=true
